# Camino SPA: raw photo originals (your personal photos -- don't commit)
/photos/*
!/photos/.gitkeep
!/photos/captions.json

# public/photos/ and src/data/photos.json ARE committed on purpose: this is
# a GitHub Pages project (served from the repo itself at build time), so the
# resized derivatives the site actually displays need to live in the repo.
# Only the raw originals above stay out.
